# Copy to .env and fill in. Never commit .env.

# Choose your own secrets (e.g. `openssl rand -base64 32`).
ARANGO_ROOT_PASSWORD=
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=

# Optional: decrypts speakers' personal data (ENC: fields).
# Output of: python3 ../tools/derive_encrypt_key.py --check <dump dir>/rms
RMS_ENCRYPT_KEY=

# Local test (defaults): web client on http://localhost:8080, API on http://localhost:8020
SITE_ADDRESS=http://localhost:8080
API_ADDRESS=http://localhost:8020
SITE_URL=http://localhost:8080
API_HOST=localhost

# Real server: two DNS names pointing at this machine; Caddy fetches TLS certificates.
# SITE_ADDRESS=rld.example.org
# API_ADDRESS=api.rld.example.org
# SITE_URL=https://rld.example.org
# API_HOST=api.rld.example.org
# (and set API_URL=https://api.rld.example.org in frontend-build.env)

# Paths (relative to this folder)
FRONTEND_DIR=../../drd-angular
DUMP_DIR=./data/dump
AUDIO_DIR=./data/audio

# Host ports for HTTP/HTTPS (keep 80/443 on a real server; change locally if taken)
HTTP_PORT=80
HTTPS_PORT=443
